{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "goodblocks/scrollytelling",
  "title": "Scrollytelling",
  "category": "goodblocks",
  "icon": "image-flip-horizontal",
  "description": "Tell a story in editable chapters with a sticky visual and scroll-linked motion.",
  "textdomain": "goodblocks",
  "attributes": {
    "visualSide": {
      "type": "string",
      "enum": [
        "left",
        "right"
      ],
      "default": "left"
    },
    "pace": {
      "type": "string",
      "enum": [
        "compact",
        "relaxed"
      ],
      "default": "relaxed"
    },
    "stickyOffset": {
      "type": "number",
      "default": 96
    },
    "anchor": {
      "type": "string"
    }
  },
  "supports": {
    "anchor": true,
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}