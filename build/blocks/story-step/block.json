{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "goodblocks/story-step",
  "title": "Story Step",
  "category": "goodblocks",
  "icon": "image-flip-horizontal",
  "description": "One scrollytelling chapter with an optional image and freely editable content.",
  "textdomain": "goodblocks",
  "attributes": {
    "mediaId": {
      "type": "number",
      "default": 0
    },
    "mediaUrl": {
      "type": "string",
      "default": ""
    },
    "mediaAlt": {
      "type": "string",
      "default": ""
    },
    "label": {
      "type": "string",
      "default": "01"
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php",
  "parent": [
    "goodblocks/scrollytelling"
  ]
}